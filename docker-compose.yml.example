services:
  nginx:
    image: nginx:alpine
    ports:
      - "80:80"
    volumes:
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      - web
      - mqtt
    restart: unless-stopped

  web:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        - NEXT_PUBLIC_MQTT_URL=${NEXT_PUBLIC_MQTT_URL:-wss://YOUR_MQTT_DOMAIN/mqtt}
        - NEXT_PUBLIC_MQTT_PATH=${NEXT_PUBLIC_MQTT_PATH:-/mqtt}
        - NEXT_PUBLIC_AMAP_KEY=${NEXT_PUBLIC_AMAP_KEY:-YOUR_AMAP_KEY}
        - NEXT_PUBLIC_AMAP_SECURITY_CODE=${NEXT_PUBLIC_AMAP_SECURITY_CODE:-YOUR_AMAP_SECURITY_CODE}
        - NEXT_PUBLIC_ESP32_STREAM_URL=${NEXT_PUBLIC_ESP32_STREAM_URL:-https://YOUR_CAMERA_STREAM_URL}
    expose:
      - "3000"
    environment:
      - REDIS_URL=redis://redis:6379
      - MQTT_SERVER_URL=mqtt://mqtt:1883
      - NEWAPI_BASE_URL=${NEWAPI_BASE_URL:-https://YOUR_NEWAPI_DOMAIN}
      - NEWAPI_API_KEY=${NEWAPI_API_KEY:-YOUR_NEWAPI_API_KEY}
    depends_on:
      - mqtt
      - redis
    restart: unless-stopped

  mqtt:
    image: eclipse-mosquitto:latest
    ports:
      - "1883:1883"
    expose:
      - "8083"
    networks:
      default:
      coolify:
    labels:
      - traefik.enable=true
      - traefik.docker.network=coolify
      - traefik.http.routers.mqtt-ws.entrypoints=https
      - traefik.http.routers.mqtt-ws.rule=Host(`mqtt.YOUR_DOMAIN`)
      - traefik.http.routers.mqtt-ws.tls=true
      - traefik.http.routers.mqtt-ws.tls.certresolver=letsencrypt
      - traefik.http.services.mqtt-ws.loadbalancer.server.port=8083
    volumes:
      - ./mosquitto.conf:/mosquitto/config/mosquitto.conf:ro
      - mosquitto_data:/mosquitto/data
      - mosquitto_log:/mosquitto/log
    restart: unless-stopped

  redis:
    image: redis:alpine
    expose:
      - "6379"
    volumes:
      - redis_data:/data
    command: redis-server --appendonly yes
    restart: unless-stopped

volumes:
  mosquitto_data:
  mosquitto_log:
  redis_data:

networks:
  coolify:
    external: true
