# ─── Smart Schoolbag V5.0 — Environment Variables ───
#
# Copy this file to .env and fill in the values.
# For Docker Compose: variables are read at build-time (NEXT_PUBLIC_*)
# and run-time (server-only).

# ── MQTT ──
# Production (Nginx proxies /mqtt on port 80):
NEXT_PUBLIC_MQTT_URL=wss://bag.versecraft.cn/mqtt
NEXT_PUBLIC_MQTT_PATH=/mqtt
# Local development (direct Mosquitto WebSocket on port 8083):
# NEXT_PUBLIC_MQTT_URL=ws://<host>:8083/mqtt

# ── AMap (高德地图) ──
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=

# ── ESP32 Camera (optional) ──
NEXT_PUBLIC_ESP32_STREAM_URL=

# ── NewAPI AI 服务（server-side only）──
# 统一 API 入口，兼容 OpenAI chat/completions 协议
# 代码固定使用模型别名 bag-image / bag-text，实际底模在 NewAPI 后台切换
# 视觉链路：图片 -> bag-image -> 结构化结果 -> bag-text -> 中文分析结果
NEWAPI_BASE_URL=https://newkey.versecraft.cn
NEWAPI_API_KEY=
