# Smart Schoolbag V5.0 environment example
# Copy to `.env.local` for local development, or map these keys in your deployment platform.

# Browser MQTT over WebSocket.
# Production browser WSS must use the single canonical address below.
NEXT_PUBLIC_MQTT_URL=wss://bag.versecraft.cn/mqtt
# Only used when NEXT_PUBLIC_MQTT_URL does not already include a path.
NEXT_PUBLIC_MQTT_PATH=/mqtt

# Server-side MQTT -> Redis mirror.
# Hardware should connect to the same broker over plain TCP MQTT.
MQTT_SERVER_URL=mqtt://mqtt.bag.versecraft.cn:1883
REDIS_URL=redis://localhost:6379

# AMap (location page only)
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=

# ESP32 camera stream (LAN mode only, optional)
NEXT_PUBLIC_ESP32_STREAM_URL=

# NewAPI (server-side only)
# Code always calls the fixed aliases `bag-image` and `bag-text`.
NEWAPI_BASE_URL=https://newkey.versecraft.cn
NEWAPI_API_KEY=
